{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["*"],
      "@models/*": ["*"],
      "@modules/*": ["*"]
    }
  },
  "include": ["**/*.ts"]
}
